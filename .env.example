# ============================================================
#  KnowBot - LLM configuration
#  Copy this file to ".env" and fill in YOUR key.
#  The .env file is git-ignored - your key never goes to GitHub.
# ============================================================

# --- Google Gemini (recommended, free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model to use (optional - sensible default per provider).
# Gemini options: gemini-2.5-flash (default, fast) | gemini-2.5-pro | gemini-2.0-flash
LLM_MODEL=

# --- Other providers (optional): leave everything you don't use empty.
# The FIRST key found below is used automatically (LLM_PROVIDER=auto).
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Force a specific provider instead of auto: auto|gemini|openai|groq|openrouter|deepseek
LLM_PROVIDER=auto

# --- Embeddings: local (offline, free) by default.
# EMBEDDINGS_PROVIDER=local
